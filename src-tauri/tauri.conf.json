{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locale Drive",
  "mainBinaryName": "Locale Drive",
  "version": "2.0.0",
  "identifier": "com.lullaby6.locale-drive",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build-server",
      "wait": true
    },
    "beforeBuildCommand": "npm run build-server"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Share and transfer files across your local network",
    "longDescription": "A Google Drive for your LAN: share and transfer files between the devices on your local network.",
    "externalBin": ["binaries/node"],
    "resources": ["server/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
